{
  "id": "launch",
  "name": "Launch Film",
  "promise": "A finished product launch video from a brief, with no filming.",
  "cost": "$0. No filming and no generation needed.",
  "generation": "optional",
  "aspect": "16:9",
  "fps": 60,
  "default": "30",
  "beats": ["hook", "problem", "product", "payoff", "close"],
  "brief_fields": ["company", "audience", "goal", "message", "must_show", "tone", "brand", "deliverables"],
  "formats": ["count_up", "word_slam", "mask_rise", "corner_stamp", "notification_stack", "marker", "strike_replace", "work_cascade", "cursor_walk", "prompt_result", "floating_device", "bento_grid", "state_gauge", "recap_check", "number_wheel", "logo_sting", "shape_match", "dot_grid", "soft_gradient", "grain_field", "particle_field", "ascii_field"],
  "notes": ["The example product and every number in it are invented. Replace them with true ones before this leaves your machine."],
  "brief": {
    "example": true,
    "product": "Ebbline",
    "company": "Ebbline answers the support questions a small team keeps getting, so people only see the hard ones.",
    "audience": "Founders running support themselves",
    "goal": "Free trial sign-ups on launch day",
    "message": "The queue clears itself before lunch.",
    "must_show": ["the queue clearing", "a person keeping the hard tickets"],
    "terms": ["support queue"],
    "tone": "Calm, exact, a little dry",
    "brand": {"colors": {"ink": "#f6f3ee", "soft": "#b7b1c4", "accent": "#ff8a5c", "panel": "#0c0a14", "surface": "#1b1730"}},
    "deliverables": ["16:9", "9:16", "1:1"],
    "length": 30
  },
  "variants": {
    "30": {
      "storyboard": {
        "title": "Ebbline launch",
        "route": "continuous",
        "clock": "music",
        "hero": {"scene": "product", "offset": 6.2},
        "layers": {"product": "Ebbline", "hook": "tickets waiting. *Before coffee.*", "offer": "Your first 500 replies are free", "cta": "Start free at ebbline.example", "tickets": "412", "price": "$0 to start", "date": "Live today"},
        "backdrop": [{"type": "soft_gradient", "seed": 3}, {"type": "dot_grid", "size": 46}, {"type": "grain_field", "strength": 0.06, "over": true}],
        "scenes": [
          {
            "id": "hook", "beat": "hook", "seconds": 4, "verb": "interrupt", "energy": 3, "carry": "the number grows into the queue",
            "shows": [],
            "camera": {"move": "push", "amount": 0.12},
            "link": {"type": "dive", "seconds": 0.9, "zoom": 4.0, "why": "The camera falls into the number, and the alerts behind it are what the number was counting."},
            "items": [
              {"type": "corner_stamp", "text": "MON 09:02", "label": "Support inbox", "corner": "tl", "start": 0},
              {"type": "count_up", "value": "{{tickets}}", "label": "{{hook}}", "start": 0, "zone": "center", "align": "center", "scale": 1.0, "role": "hook"}
            ],
            "sound": [{"name": "tick", "at": 0.05}, {"name": "pop", "at": 1.05}, {"name": "rise", "at": 3.1}]
          },
          {
            "id": "problem", "beat": "problem", "seconds": 7, "verb": "pile up", "energy": 5, "carry": "the alerts slide off the way the camera is going",
            "shows": [],
            "camera": {"move": "pan", "x": -0.022},
            "link": {"type": "pan", "seconds": 0.7, "why": "The same sideways move carries us off the pile and onto the product."},
            "items": [
              {"type": "mask_rise", "lines": ["Same five", "*questions.*"], "start": 0.35, "duration": 3.3, "zone": "left"},
              {"type": "notification_stack", "zone": "right", "start": 0.2, "duration": 3.5, "alerts": [{"text": "Where is my order?", "label": "Ticket 4417"}, {"text": "How do I reset my password?", "label": "Ticket 4418"}, {"text": "Can I change my plan?", "label": "Ticket 4419"}, {"text": "Where is my order?", "label": "Ticket 4420"}, {"text": "Refund for a double charge", "label": "Ticket 4421"}]},
              {"type": "marker", "text": "All day, your team *copies and pastes.*", "start": 3.9, "zone": "center", "align": "center"}
            ],
            "sound": [{"name": "ding", "at": 0.3}, {"name": "ding", "at": 1.3}, {"name": "ding", "at": 2.3}, {"name": "whoosh", "at": 6.5}]
          },
          {
            "id": "product", "beat": "product", "seconds": 8, "verb": "clear", "energy": 8, "carry": "the zero stays in mind as the camera pulls away",
            "shows": ["the queue clearing"],
            "silences": [{"from": 5.65, "to": 6.2}],
            "camera": {"poses": [{"at": 0, "scale": 1.0, "ry": -7, "rx": 5}, {"at": 5.9, "scale": 1.05, "ry": 2, "rx": 2}, {"at": 7.9, "scale": 0.9, "ry": 0, "rx": 0}], "origin": "right"},
            "link": {"type": "through", "seconds": 0.7, "why": "The pull-back turns into the push that lands on the result."},
            "items": [
              {"type": "word_slam", "text": "{{product}} answers *first.*", "start": 0.3, "zone": "left", "important": true},
              {"type": "work_cascade", "title": "Support *queue*", "from": "{{tickets}}", "to": 0, "label": "open", "done": "Queue *clear* before lunch", "start": 0.2, "zone": "right", "rows": [{"text": "Where is my order?", "label": "Orders"}, {"text": "Reset my password", "label": "Account"}, {"text": "Change my plan", "label": "Billing"}, {"text": "Refund a double charge", "label": "Billing"}, {"text": "Cancel my renewal", "label": "Billing"}]}
            ],
            "sound": [{"name": "click", "at": 0.7}, {"name": "tick", "at": 1.6}, {"name": "tick", "at": 2.6}, {"name": "tick", "at": 3.6}, {"name": "tick", "at": 4.6}, {"name": "boom", "at": 6.2}]
          },
          {
            "id": "payoff", "beat": "payoff", "seconds": 6, "verb": "prove", "energy": 9, "carry": "the last tick lands on the mark",
            "shows": ["a person keeping the hard tickets"],
            "camera": {"move": "push", "amount": 0.05},
            "link": {"type": "through", "seconds": 0.8, "why": "The last tick pushes through into the mark, so the film ends on the name."},
            "items": [
              {"type": "strike_replace", "lead": "First reply in", "swap": ["3 hours", "40 seconds"], "start": 0.2, "zone": "left"},
              {"type": "recap_check", "title": "What you *get back*", "points": ["Replies in your tone", "A person keeps the hard tickets", "Every fix teaches it"], "start": 0.5, "zone": "right"}
            ],
            "sound": [{"name": "thud", "at": 1.4}, {"name": "ding", "at": 2.6}]
          },
          {
            "id": "close", "beat": "close", "seconds": 5, "verb": "land", "energy": 6,
            "backdrop": [{"type": "particle_field", "seed": 4, "count": 80}],
            "camera": {"move": "push", "amount": 0.035},
            "items": [
              {"type": "logo_sting", "text": "{{product}}", "label": "{{offer}}", "cta": "{{cta}}", "start": 0.1, "duration": 4.9, "role": "cta"}
            ],
            "sound": [{"name": "boom", "at": 0.15}]
          }
        ]
      }
    }
  }
}
